CONFIG_KUNIT=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_SWAP=y
CONFIG_MMU=y
CONFIG_64BIT=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=n
CONFIG_ZSWAP=n
CONFIG_MEMCOMP=y
CONFIG_MEMCOMP_KUNIT_TEST=y
CONFIG_CRYPTO_LZ4=y
# Compile the batched folio-release path with memory accounting enabled.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_KSM=y
